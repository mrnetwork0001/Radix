# Radix — local development environment
#
# Copy to `.env` (which is git-ignored) and edit if you need non-default ports:
#     cp .env.example .env
#
# Docker Compose reads `.env` automatically; the Makefile and the backend read
# the same file, so one copy configures the whole stack.

# --- HydraDB ---------------------------------------------------------------
# Must match the contents of ./hydra/auth-token byte for byte. HydraDB reads the
# token from a FILE (GRAPH_AUTH_TOKEN_FILE) — there is no env-var form — and
# rejects anything shorter than 32 bytes. This value is exactly 32.
HYDRA_AUTH_TOKEN=local-development-token-32-bytes

# Host-side endpoints. The container always binds 0.0.0.0 on the ports below;
# only the host-side mapping is configurable here.
HYDRA_BOLT_PORT=7687
HYDRA_HTTP_PORT=8443
HYDRA_ADMIN_PORT=9090

HYDRA_HTTP_URL=http://127.0.0.1:8443
HYDRA_ADMIN_URL=http://127.0.0.1:9090
HYDRA_BOLT_URL=bolt://127.0.0.1:7687

# Graph coordinates — these are baked into every query the backend sends
# (`X-Graph-Namespace` header, the `/v1/graphs/{graph_id}/query` path, and the
# required `cell_id` field in the request body).
HYDRA_NAMESPACE=radix
HYDRA_GRAPH_ID=default
HYDRA_CELL_ID=cell-0

# Pinned so a re-pull cannot silently swap the engine under a verified contract.
HYDRA_IMAGE=ghcr.io/hydra-db/hydradb:latest

# --- Application processes (run locally, not containerised) -----------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Vite proxies /api -> BACKEND, so the frontend needs no absolute base URL.
VITE_API_BASE=/api
