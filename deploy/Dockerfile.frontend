# Radix frontend image: vite build in node, served by nginx.
#
# Build context is the REPO ROOT (compose runs with `--project-directory .`):
#   docker build -f deploy/Dockerfile.frontend .

# --- build stage -----------------------------------------------------------
FROM node:22-alpine AS build

WORKDIR /build

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# Sources are copied file-by-file on purpose: `COPY frontend/ .` would drag in
# the host's node_modules (macOS-native binaries) and stale dist/ output.
COPY frontend/index.html \
     frontend/vite.config.ts \
     frontend/tsconfig.json \
     frontend/tsconfig.node.json \
     frontend/tailwind.config.js \
     frontend/postcss.config.js \
     ./
COPY frontend/src ./src

# `npm run build` = `tsc --noEmit && vite build` - the type check runs too.
RUN npm run build

# --- serve stage -----------------------------------------------------------
FROM nginx:alpine

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/dist /usr/share/nginx/html

EXPOSE 80
