    { "id": "graph.packages",         "where": "README Measured results", "expect": 390,  "op": "eq" },
    { "id": "graph.services",         "where": "README track questions",  "expect": 20,   "op": "eq" },
    { "id": "graph.lockfiles",        "where": "README track questions",  "expect": 10,   "op": "eq" },
    { "id": "blast.exposed_services", "where": "README + video script",   "expect": 7,    "op": "eq" },
    { "id": "blast.percentage",       "where": "README + video script",   "expect": 35.0, "op": "eq" },
    { "id": "blast.tier1",            "where": "README Measured results", "expect": 3,    "op": "eq" },
    { "id": "blast.exposed_lockfiles","where": "README track questions",  "expect": 4,    "op": "eq" },
    { "id": "closure.packages",       "where": "README Measured results", "expect": 22,   "op": "eq" },
