    { "id": "precision.excluded_names", "where": "README names them",     "expect": ["svelte-query-shim", "vue-query-shim"], "op": "eq" },
    { "id": "depth8.exposed_services","where": "README depth 8 finds 9",  "expect": 9,    "op": "eq" },
