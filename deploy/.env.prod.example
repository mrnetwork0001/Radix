# Radix production environment.
#
#   cp deploy/.env.prod.example deploy/.env.prod   # then edit — never commit it
#
# Read by BOTH runners: docker compose (via --env-file deploy/.env.prod, used
# for ${...} interpolation in deploy/docker-compose.prod.yml) and systemd (via
# EnvironmentFile= in deploy/radix-sentinel.service). Keep it plain KEY=VALUE:
# no `export`, no quotes.

# --- Secrets ---------------------------------------------------------------
# The HydraDB auth token, ≥32 bytes. Generate once:
#   openssl rand -hex 32 | tee hydra/auth-token
# HydraDB reads the FILE; backend and sentinel read this VARIABLE. The two
# must match byte for byte (no trailing whitespace differences).
HYDRA_TOKEN=replace-with-the-output-of-openssl-rand-hex-32

# Host path of the token file mounted read-only into the hydra container.
# Relative paths resolve against the repo root (--project-directory .).
HYDRA_TOKEN_FILE=./hydra/auth-token

# --- Graph coordinates -----------------------------------------------------
# `radix-live` holds real ingested data. The seeded demo world lives in
# `radix`; point the stack there instead if you only want the demo.
HYDRA_NAMESPACE=radix-live

# --- Sentinel --------------------------------------------------------------
# Seconds between OSV advisory sweeps.
SENTINEL_INTERVAL=900

# Optional: comma-separated repos (paths or git URLs) re-ingested every cycle.
# Empty disables re-scanning; advisories are still swept either way.
SENTINEL_REPOS=

# --- Bare-metal sentinel only (deploy/radix-sentinel.service) --------------
# Containers get in-network URLs from docker-compose.prod.yml and ignore
# these. A systemd-run sentinel needs HydraDB published on loopback — see the
# commented `ports:` block on the hydra service.
HYDRA_HTTP_URL=http://127.0.0.1:8443
HYDRA_ADMIN_URL=http://127.0.0.1:9090

# --- Optional overrides ----------------------------------------------------
# Pin the engine image so a re-pull cannot swap it under the verified contract.
HYDRA_IMAGE=ghcr.io/hydra-db/hydradb:latest
